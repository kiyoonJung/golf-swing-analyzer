{
  "name": "swing-fixer-app",
  "version": "1.0.0",
  "private": true,
  "description": "골프 스윙 포즈 분석 - Capacitor 모바일 앱 (iOS/Android)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "build:native": "node scripts/build-www.mjs --native",
    "build:slim": "node scripts/build-www.mjs --slim",
    "build:web": "node scripts/build-www.mjs --no-heavy",
    "sync": "npm run build:native && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "patch-native": "node scripts/patch-native.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@mediapipe/pose": "0.5.1675469404"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "wrangler": "^4.0.0"
  }
}
